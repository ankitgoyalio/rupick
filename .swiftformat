--swift-version 6.0
--indent 4
--enable acronyms
--enable blankLineAfterSwitchCase
--enable blankLinesAfterGuardStatements
--enable blockComments
--enable emptyExtensions
--enable ifExpressions
--enable isEmpty
--enable markTypes
--enable noExplicitOwnership
--enable preferContains
--enable preferCountWhere
--enable preferExplicitFalse
--enable preferFinalClasses
--enable preferFirstWhere
--enable preferFlatMap
--enable preferLazyMap
--enable preferMinOverSorted
--enable preferSwiftStringAPI
--enable preferSwiftTesting
--enable propertyTypes
--enable singlePropertyPerLine
--enable sortSwitchCases
--enable testSuiteAccessControl
--enable unusedPrivateDeclarations
--enable urlMacro
--enable validateTestCases
--enable wrapCaseBodies
--enable wrapEnumCases
--enable wrapGuardStatementBodies
--enable wrapMultilineConditionalAssignment
--enable wrapMultilineFunctionChains
--enable wrapSwitchCases
--blank-line-after-switch-case always
--line-between-guards true
--property-types inferred
# urlMacro requires --url-macro "#MacroName,Module" and a matching dependency.
# Key-path predicates inside Swift Testing macros can fail to compile.
--disable preferKeyPath
--exclude BuildTools,.build,.swiftpm
